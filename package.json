{
  "name": "@subf/config",
  "version": "0.4.0",
  "description": "Universal configuration for TypeScript, oxlint (+unocss, +solid), oxfmt, and tsdown.",
  "keywords": [
    "config",
    "configuration",
    "eslint",
    "oxfmt",
    "oxlint",
    "prettier",
    "shared config",
    "solidjs",
    "tsdown",
    "typescript",
    "universal config"
  ],
  "homepage": "https://github.com/subframe7536/config#readme",
  "bugs": {
    "url": "https://github.com/subframe7536/config/issues"
  },
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/config.git"
  },
  "bin": {
    "subf": "./bin/subf.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "exports": {
    "./oxfmt": "./dist/oxfmt.js",
    "./oxlint": "./dist/oxlint.js",
    "./tsdown": "./dist/tsdown.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "release": "bumpp --all",
    "qa": "nub run lint && nub run format && nub run typecheck",
    "prepublishOnly": "nub run build"
  },
  "dependencies": {
    "@subf/oxlint-plugin": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "bumpp": "^11.1.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "defu": "6.1.7",
    "oxfmt": "^0",
    "oxlint": "^1"
  }
}
